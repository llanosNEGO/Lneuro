---
import Logo from "./Logo.astro";
import { Phone, MessageCircle, Menu, X } from "lucide-astro";
import { contactData } from "../data/contact";

const whatsappMsg = encodeURIComponent(
  "Hola, quisiera recibir información sobre los servicios y talleres de NeuroAprendiendo.",
);
const whatsappUrl = `https://wa.me/${contactData.phones[0].raw}?text=${whatsappMsg}`;
---

<header
  id="main-header"
  class="sticky top-0 z-50 w-full transition-all duration-300 bg-brand-cream/95 backdrop-blur-md border-b border-brand-border/80 shadow-sm"
>
  <div
    class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 h-24 flex items-center justify-between"
  >
    <!-- Brand Logo (Pushed to the far left) -->
    <a
      href="#inicio"
      aria-label="Ir al inicio de NeuroAprendiendo"
      class="shrink-0 py-1 mr-auto lg:mr-16"
    >
      <Logo size="md" />
    </a>

    <!-- Desktop Navigation (Clean & Spaced out) -->
    <nav
      class="hidden lg:flex items-center gap-8 font-bold text-base text-slate-800"
    >
      <a href="#inicio" class="hover:text-brand-orange transition-colors"
        >Inicio</a
      >
      <a href="#servicios" class="hover:text-brand-orange transition-colors"
        >Servicios</a
      >
      <a href="#adulto-mayor" class="hover:text-brand-orange transition-colors">
        Adulto Mayor
      </a>
      <a href="#nosotros" class="hover:text-brand-orange transition-colors"
        >Nosotros</a
      >
      <a href="#galeria" class="hover:text-brand-orange transition-colors"
        >Instalaciones</a
      >
      <a href="#contacto" class="hover:text-brand-orange transition-colors"
        >Contacto</a
      >
    </nav>

    <!-- Header Actions -->
    <div class="hidden sm:flex items-center gap-3 ml-6 lg:ml-8">
      <!-- <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-sm uppercase tracking-wider transition-all shadow-md shadow-emerald-600/20 hover:shadow-emerald-600/30 hover:-translate-y-0.5 h-11"
      >
        <MessageCircle class="w-4 h-4" />
        WhatsApp
      </a> -->
      <a
        href="#contacto"
        class="inline-flex items-center gap-2 px-5 rounded-xl bg-brand-orange hover:bg-brand-orange-hover text-white font-extrabold text-sm uppercase tracking-wider transition-all shadow-md shadow-brand-orange/25 hover:shadow-brand-orange/40 hover:-translate-y-0.5 h-11"
      >
        Reservar cita
      </a>
    </div>

    <!-- Mobile Menu Toggle Button -->
    <button
      id="menu-toggle"
      type="button"
      class="lg:hidden p-2.5 rounded-xl text-slate-800 hover:text-brand-orange hover:bg-orange-100/60 transition-colors focus:outline-none focus:ring-2 focus:ring-brand-orange"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Menu id="icon-menu" class="w-8 h-8 block" />
      <X id="icon-close" class="w-8 h-8 hidden" />
    </button>
  </div>

  <!-- Mobile Menu Drawer -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-b border-brand-border bg-white/95 backdrop-blur-xl px-6 py-8 transition-all shadow-xl"
  >
    <nav class="flex flex-col gap-5 font-bold text-lg text-slate-800">
      <a
        href="#inicio"
        class="mobile-nav-link py-2 border-b border-slate-100 hover:text-brand-orange"
        >Inicio</a
      >
      <a
        href="#servicios"
        class="mobile-nav-link py-2 border-b border-slate-100 hover:text-brand-orange"
        >Servicios</a
      >
      <a
        href="#adulto-mayor"
        class="mobile-nav-link py-3 px-4 rounded-xl bg-amber-50 text-amber-950 font-extrabold text-base hover:bg-amber-100 flex items-center justify-between border border-amber-200"
      >
        <span>Talleres Adulto Mayor</span>
        <span
          class="text-xs bg-brand-orange text-white px-2.5 py-1 rounded-full font-bold"
          >L-M-V</span
        >
      </a>
      <a
        href="#nosotros"
        class="mobile-nav-link py-2 border-b border-slate-100 hover:text-brand-orange"
        >Sobre Nosotros</a
      >
      <a
        href="#galeria"
        class="mobile-nav-link py-2 border-b border-slate-100 hover:text-brand-orange"
        >Instalaciones</a
      >
      <a
        href="#contacto"
        class="mobile-nav-link py-2 border-b border-slate-100 hover:text-brand-orange"
        >Ubicación y Contacto</a
      >
    </nav>
    <div class="mt-8 flex flex-col gap-4">
      <!-- <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full text-center py-3.5 rounded-xl bg-emerald-600 text-white font-extrabold text-base shadow-md shadow-emerald-600/20 flex items-center justify-center gap-2"
      >
        <MessageCircle class="w-5 h-5" />
        Escribir por WhatsApp
      </a> -->
      <a
        href="#contacto"
        class="mobile-nav-link w-full text-center py-3.5 rounded-xl bg-brand-orange text-white font-extrabold text-base shadow-md shadow-brand-orange/20"
      >
        Solicitar Información
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const iconMenu = document.getElementById("icon-menu");
  const iconClose = document.getElementById("icon-close");
  const mobileLinks = document.querySelectorAll(".mobile-nav-link");

  function toggleMenu() {
    const isOpen = mobileMenu?.classList.contains("hidden") === false;
    if (isOpen) {
      mobileMenu?.classList.add("hidden");
      iconMenu?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
      toggleBtn?.setAttribute("aria-expanded", "false");
    } else {
      mobileMenu?.classList.remove("hidden");
      iconMenu?.classList.add("hidden");
      iconClose?.classList.remove("hidden");
      toggleBtn?.setAttribute("aria-expanded", "true");
    }
  }

  toggleBtn?.addEventListener("click", toggleMenu);

  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      if (!mobileMenu?.classList.contains("hidden")) {
        toggleMenu();
      }
    });
  });

  // Close on Escape
  window.addEventListener("keydown", (e) => {
    if (
      e.key === "Escape" &&
      mobileMenu &&
      !mobileMenu.classList.contains("hidden")
    ) {
      toggleMenu();
    }
  });
</script>
