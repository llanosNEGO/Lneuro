---
import {
  Heart,
  Sparkles,
  Smile,
  ShieldCheck,
  Sun,
  CheckCircle,
} from "lucide-astro";

const pillars = [
  {
    title: "Cercanía y Calidez",
    desc: "Un trato humano, acogedor y personalizado en cada sesión.",
    icon: Heart,
    color: "bg-rose-100 text-rose-700",
  },
  {
    title: "Metodología Integral",
    desc: "Abordamos el crecimiento cognitivo, físico y socioemocional.",
    icon: Sparkles,
    color: "bg-amber-100 text-amber-800",
  },
  {
    title: "Entorno Seguro",
    desc: "Instalaciones preparadas para brindar comodidad y confianza.",
    icon: ShieldCheck,
    color: "bg-emerald-100 text-emerald-800",
  },
  {
    title: "Acompañamiento Continuo",
    desc: "Orientación cercana a las familias en cada etapa del camino.",
    icon: Sun,
    color: "bg-orange-100 text-orange-800",
  },
];
---

<section
  id="nosotros"
  class="scroll-mt-28 py-14 bg-brand-cream relative overflow-hidden"
>
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Visual Asymmetric Composition Column (5 cols) -->
      <div class="lg:col-span-5 relative" data-reveal="left">
        <div
          class="relative rounded-3xl bg-gradient-to-tr from-amber-400 via-brand-orange to-brand-yellow p-4 shadow-xl"
        >
          <div class="rounded-2xl bg-white p-6 text-center space-y-6">
            <div
              class="w-16 h-16 rounded-2xl bg-orange-100 text-brand-orange flex items-center justify-center mx-auto text-3xl"
            >
              🌿
            </div>

            <h3 class="text-2xl font-extrabold text-brand-dark">
              Aprender, Explorar y Crecer
            </h3>

            <p class="text-sm text-slate-600 leading-relaxed">
              Creemos firmemente en el potencial único de cada persona. Nuestro
              compromiso es acompañar a niños, jóvenes y adultos mayores con
              herramientas que fortalecen sus habilidades individuales.
            </p>

            <div class="pt-4 border-t border-slate-100 space-y-3 text-left">
              <div
                class="flex items-center gap-3 text-xs font-bold text-slate-700"
              >
                <CheckCircle class="w-4 h-4 text-emerald-600 shrink-0" />
                <span
                  >Espacios acondicionados para talleres de estimulación</span
                >
              </div>
              <div
                class="flex items-center gap-3 text-xs font-bold text-slate-700"
              >
                <CheckCircle class="w-4 h-4 text-emerald-600 shrink-0" />
                <span>Metodologías activas y participativas</span>
              </div>
              <div
                class="flex items-center gap-3 text-xs font-bold text-slate-700"
              >
                <CheckCircle class="w-4 h-4 text-emerald-600 shrink-0" />
                <span>Atención a las necesidades emocionales y cognitivas</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Content Column (7 cols) -->
      <div class="lg:col-span-7 space-y-6" data-reveal="right">
        <span
          class="inline-block px-4 py-1.5 rounded-full bg-orange-100 text-brand-orange font-extrabold text-xs uppercase tracking-wider"
        >
          NUESTRA FILOSOFÍA
        </span>

        <h2
          class="text-3xl sm:text-4xl font-extrabold text-brand-dark tracking-tight"
        >
          Cada experiencia puede abrir nuevas posibilidades
        </h2>

        <p class="text-slate-700 text-base leading-relaxed">
          En NeuroAprendiendo entendemos el desarrollo mental no como un proceso
          aislado, sino como una vivencia continua enriquecida por la emoción,
          el cuerpo y el entorno social.
        </p>

        <!-- Pillars Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
          {
            pillars.map((p, idx) => {
              const Icon = p.icon;
              const delay = (idx * 100).toString();
              return (
                <div
                  data-reveal="up"
                  data-reveal-delay={delay}
                  class="p-5 rounded-2xl bg-white border border-brand-border shadow-sm hover:shadow-md transition-shadow"
                >
                  <div
                    class={`w-10 h-10 rounded-xl ${p.color} flex items-center justify-center mb-3`}
                  >
                    <Icon class="w-5 h-5" />
                  </div>
                  <h4 class="font-extrabold text-brand-dark text-base mb-1">
                    {p.title}
                  </h4>
                  <p class="text-xs text-slate-600 leading-relaxed">{p.desc}</p>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</section>
