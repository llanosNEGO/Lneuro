---
interface Props {
  size?: "sm" | "md" | "lg";
  showFootprints?: boolean;
}

const { size = "md", showFootprints = true } = Astro.props;

// Size configurations
const sizeClasses = {
  sm: {
    subtitle: "text-[9px] tracking-[0.18em]",
    title: "text-lg sm:text-xl",
    sun: "w-6 h-6 -top-2 -right-3",
    footprints: "h-3 gap-1 mt-0.5",
    stroke: "logo-stroke-sm"
  },
  md: {
    subtitle: "text-[10px] sm:text-[11px] tracking-[0.2em]",
    title: "text-2xl sm:text-3xl",
    sun: "w-8 h-8 -top-3 -right-5",
    footprints: "h-4 gap-1.5 mt-1",
    stroke: "logo-stroke"
  },
  lg: {
    subtitle: "text-xs sm:text-sm tracking-[0.22em]",
    title: "text-4xl sm:text-5xl lg:text-6xl",
    sun: "w-12 h-12 -top-5 -right-8",
    footprints: "h-6 gap-2 mt-2",
    stroke: "logo-stroke-lg"
  }
};

const current = sizeClasses[size];

// Multicolor sequence matching official brand logo
const letterColors = [
  { char: 'N', color: '#FFB800' }, // Yellow
  { char: 'e', color: '#FFB800' }, // Red
  { char: 'u', color: '#E53935' }, // Pink
  { char: 'r', color: '#E53935' }, // Purple
  { char: 'o', color: '#E53935' }, // Blue
  { char: 'A', color: '#29B6F6' }, // Green
  { char: 'p', color: '#29B6F6' }, // Orange
  { char: 'r', color: '#29B6F6' }, // Yellow-Gold
  { char: 'e', color: '#29B6F6' }, // Coral Red
  { char: 'n', color: '#29B6F6' }, // Bright Pink
  { char: 'd', color: '#35D982' }, // Medium Purple
  { char: 'i', color: '#35D982' }, // Teal
  { char: 'e', color: '#35D982' }, // Sky Blue
  { char: 'n', color: '#35D982' }, // Green
  { char: 'd', color: '#FFA726' }, // Orange
  { char: 'o', color: '#FFA726' }, // Magenta
];

// Color palette for footprints
const footprintColors = [
  '#94A3B8', // Grey
  '#E53935', // Red
  '#35D982', // Green
  '#FFB800', // Yellow
  '#9C27B0', // Purple
  '#FF762F', // Orange
];
---

<div class="inline-flex flex-col items-center text-center select-none group">
  
  <!-- Subtitle Institutional Text -->
  <span class={`font-extrabold text-slate-800 uppercase ${current.subtitle} mb-0.5 leading-none`}>
    CENTRO PSICOLÓGICO INTEGRAL
  </span>

  <!-- Main Multicolor Brand Name with Sun Motif -->
  <div class="relative inline-block">
    
    <!-- Sun Yellow Element with Spiral Center -->
    <div class={`absolute ${current.sun} pointer-events-none group-hover:scale-110 group-hover:rotate-12 transition-transform duration-300 z-10`}>
      <svg viewBox="0 0 100 100" class="w-full h-full drop-shadow-md">
        <!-- Sun Rays -->
        <g stroke="#FFB800" stroke-width="8" stroke-linecap="round">
          <line x1="50" y1="10" x2="50" y2="2" />
          <line x1="50" y1="90" x2="50" y2="98" />
          <line x1="10" y1="50" x2="2" y2="50" />
          <line x1="90" y1="50" x2="98" y2="50" />
          <line x1="22" y1="22" x2="16" y2="16" />
          <line x1="78" y1="78" x2="84" y2="84" />
          <line x1="22" y1="78" x2="16" y2="84" />
          <line x1="78" y1="22" x2="84" y2="16" />
        </g>
        <!-- Sun Circle Core -->
        <circle cx="50" cy="50" r="26" fill="#FFD83D" stroke="#1E293B" stroke-width="3" />
        <!-- Spiral Core -->
        <path d="M 50 50 m -12 0 a 12 12 0 1 0 24 0 a 8 8 0 1 0 -16 0 a 4 4 0 1 0 8 0" fill="none" stroke="#FF762F" stroke-width="3.5" stroke-linecap="round" />
      </svg>
    </div>

    <!-- Multicolor Lettering "NeuroAprendiendo" -->
    <h1 class={`font-brand-display ${current.title} ${current.stroke} tracking-tight leading-none inline-flex items-center`}>
      {letterColors.map((l) => (
        <span 
          style={`color: ${l.color}; text-shadow: 0px 2px 0px rgba(0,0,0,0.15);`} 
          class="inline-block transition-transform group-hover:-translate-y-0.5"
        >
          {l.char}
        </span>
      ))}
    </h1>
  </div>

  <!-- Color Footprints (Huellas) -->
  {showFootprints && (
    <div class={`flex items-center justify-center ${current.footprints}`}>
      {footprintColors.map((color, idx) => (
        <svg 
          viewBox="0 0 24 32" 
          class="h-full w-auto fill-current transition-transform duration-200 group-hover:scale-110" 
          style={`color: ${color}; transform: rotate(${idx % 2 === 0 ? '-12deg' : '12deg'});`}
          aria-hidden="true"
        >
          <!-- Foot sole -->
          <ellipse cx="12" cy="20" rx="7" ry="9" stroke="#1E293B" stroke-width="1.2" />
          <!-- Toes -->
          <circle cx="6" cy="7" r="2.2" stroke="#1E293B" stroke-width="1" />
          <circle cx="10" cy="5" r="2.5" stroke="#1E293B" stroke-width="1" />
          <circle cx="14" cy="5" r="2.5" stroke="#1E293B" stroke-width="1" />
          <circle cx="18" cy="7" r="2.2" stroke="#1E293B" stroke-width="1" />
          <circle cx="21" cy="10" r="1.8" stroke="#1E293B" stroke-width="1" />
        </svg>
      ))}
    </div>
  )}

</div>
