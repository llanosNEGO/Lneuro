---
import { ShieldCheck, HeartHandshake, UserCheck, BookOpen } from 'lucide-astro';

const commitments = [
  {
    icon: HeartHandshake,
    title: "Vocación de Servicio y Calidez",
    description: "Brindamos atención empática y humana, generando un ambiente de confianza mutua para niños, adultos mayores y sus familias."
  },
  {
    icon: UserCheck,
    title: "Atención Adaptada a Cada Etapa",
    description: "Diseñamos metodologías específicas según el ritmo, las fortalezas e intereses individuales de cada participante."
  },
  {
    icon: ShieldCheck,
    title: "Espacio Profesional e Integral",
    description: "Trabajamos con un enfoque orientado al desarrollo mental, el bienestar físico y la conexión emocional constante."
  },
  {
    icon: BookOpen,
    title: "Innovación en Neuroaprendizaje",
    description: "Aplicamos actividades actualizadas de estimulación cognitiva, talleres creativos y mindfulness funcional."
  }
];
---

<section class="py-20 bg-gradient-to-b from-brand-cream via-orange-50/30 to-brand-cream border-t border-brand-border/40">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16" data-reveal="up">
      <span class="inline-block px-4 py-1.5 rounded-full bg-orange-100 text-brand-orange font-extrabold text-xs uppercase tracking-wider mb-3">
        NUESTRO COMPROMISO
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-dark tracking-tight">
        Un acompañamiento cercano y profesional
      </h2>
      <p class="mt-4 text-slate-600 text-base leading-relaxed">
        En NeuroAprendiendo nos guía el respeto por cada individuo y el deseo sincero de construir mejores oportunidades de crecimiento personal y familiar.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {commitments.map((c, idx) => {
        const Icon = c.icon;
        const delay = (idx * 110).toString();
        return (
          <div 
            data-reveal="up" 
            data-reveal-delay={delay}
            class="p-6 rounded-3xl bg-white border border-brand-border shadow-sm hover:shadow-md transition-all duration-200"
          >
            <div class="w-12 h-12 rounded-2xl bg-orange-100 text-brand-orange flex items-center justify-center mb-5">
              <Icon class="w-6 h-6 stroke-[2]" />
            </div>
            <h3 class="font-extrabold text-brand-dark text-lg mb-2">
              {c.title}
            </h3>
            <p class="text-slate-600 text-xs leading-relaxed">
              {c.description}
            </p>
          </div>
        );
      })}
    </div>

  </div>
</section>
